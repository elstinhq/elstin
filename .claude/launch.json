{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "postgres",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "FORGE_PG_PORT=15433 docker-compose up postgres"],
      "port": 15433
    },
    {
      "name": "app",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "source .venv/bin/activate && export DATABASE_URL='postgresql+psycopg://forge:forge@localhost:15433/forge' && uvicorn forge.app:create_app --factory --host localhost --port 8000"],
      "port": 8000,
      "url": "http://localhost:8000"
    }
  ]
}
