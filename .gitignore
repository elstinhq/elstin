__pycache__/
*.pyc
.venv/
*.egg-info/
.pytest_cache/
repos/
.DS_Store
.claude/settings.local.json

# Build output, not source: `cd ui-src && npm install && npm run build`
# regenerates settings-ui/vendor/ from ui-src/src/ in seconds, and the
# Dockerfile's ui-build stage does the same inside the image. Every
# frontend dependency is public, so nothing here needs credentials to
# rebuild.
ui-src/node_modules/
settings-ui/vendor/

# Usage exports downloaded from OpenRouter's activity page.
openrouter_activity_*.csv

# The app's database and its LangGraph checkpoints hold every credential the
# settings page stores; one stray `sqlite:///elstin.db` must never be committed.
*.db
*.db-wal
*.db-shm
# The preview server's own database (.claude/launch.json), apart from your real one.
.dev-data/

# Packaging output: the standalone Python, the build venv, the bundle (packaging/build-backend.sh).
build/
dist/
.build/
